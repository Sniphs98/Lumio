# Postgres connection string (matches docker-compose.dev.yml)
DATABASE_URL="postgres://lumio:lumio@localhost:5432/lumio"

# Public URL of the app
ORIGIN="http://localhost:5173"

# Better Auth: use 32+ random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# LiveKit (voice, video, screen sharing)
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_change_me_devsecret_change_me"

# Optional OpenTelemetry tracing, e.g. to the Jaeger from docker-compose.dev.yml
# (`--profile tracing`). Leave unset to turn tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Files shared in chats are stored in this folder (default: data/uploads), or in an
# S3 bucket when S3_BUCKET is set (S3_REGION, S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY).
# UPLOAD_DIR="data/uploads"

# Optional sign in with Discord. Create an application at https://discord.com/developers/applications
# and add the redirect http://localhost:5173/api/auth/callback/discord.
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""
