# Copy to the repository root as .env and fill in.

# Image version to run, e.g. 0.1.0, or 0.1 to get its bug fixes. Defaults to latest.
# LUMIO_VERSION=

# Both domains must point to this server (A/AAAA records).
LUMIO_DOMAIN=chat.example.com
LIVEKIT_DOMAIN=rtc.example.com

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
LIVEKIT_API_KEY=lumio
LIVEKIT_API_SECRET=

# Optional tracing (see "Tracing" in the README). To use the bundled Jaeger:
# COMPOSE_PROFILES=tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Optional sign in with Discord (see "Sign in with Discord" in the README).
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Optional S3 bucket (AWS, Cloudflare R2, MinIO, ...) for files shared in chats.
# Leave empty to store them on this server in the "uploads" volume.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
