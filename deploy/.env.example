# Copy to the repository root as .env and fill in.

# Image version to run, e.g. 0.1.0, or 0.1 to get its bug fixes. Defaults to latest.
# LUMIO_VERSION=

# Both domains must point to this server (A/AAAA records).
LUMIO_DOMAIN=chat.example.com
LIVEKIT_DOMAIN=rtc.example.com

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
LIVEKIT_API_KEY=lumio
LIVEKIT_API_SECRET=

# Already running a reverse proxy (nginx, Traefik, ...)? Use the compose file without Caddy,
# see deploy/reverse-proxy/README.md:
# COMPOSE_FILE=docker-compose.proxy.yml
# Address and port the app is published on for your proxy (default 127.0.0.1:3000).
# LUMIO_BIND=127.0.0.1
# LUMIO_PORT=3000
# Number of proxies in front of the app that append to X-Forwarded-For (default 1). Behind a
# CDN such as Cloudflare use ADDRESS_HEADER=CF-Connecting-IP instead.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
# LiveKit on a path of the app domain instead of LIVEKIT_DOMAIN:
# LIVEKIT_URL=wss://chat.example.com/livekit

# Optional tracing (see "Tracing" in the README). To use the bundled Jaeger:
# COMPOSE_PROFILES=tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Optional sign in with Discord, Google and Steam, each off while empty
# (see "Sign in with Discord, Google or Steam" in the README).
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STEAM_API_KEY=

# Optional S3 bucket (AWS, Cloudflare R2, MinIO, ...) for files shared in chats.
# Leave empty to store them on this server in the "uploads" volume.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional GIFs in chats (see "GIFs" in the README). Giphy wins when both are set.
# GIPHY_API_KEY=
# TENOR_API_KEY=
