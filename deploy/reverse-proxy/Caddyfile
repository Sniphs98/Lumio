# Lumio behind a Caddy you already run on the host (not the one in docker-compose.yml).
# Replace the domains with LUMIO_DOMAIN and LIVEKIT_DOMAIN and start Lumio with
# docker-compose.proxy.yml. Caddy gets the certificates, sets X-Forwarded-For and
# X-Forwarded-Proto, passes WebSockets on and sends Server-Sent Events through unbuffered
# on its own.

chat.example.com {
	reverse_proxy 127.0.0.1:3000

	# Alternative to a second domain: serve LiveKit from a path of the app domain. Set
	# LIVEKIT_URL=wss://chat.example.com/livekit in .env and remove the block below.
	# handle_path /livekit/* {
	# 	reverse_proxy 127.0.0.1:7880
	# }
}

# LiveKit signaling (WebSocket). Media goes directly to LiveKit over UDP, not through Caddy.
rtc.example.com {
	reverse_proxy 127.0.0.1:7880
}
